# Dependencies
node_modules/

# Build output
dist/
android/app/build/
android/.gradle/
android/build/
android/.idea/
android/local.properties
*.apk
*.aab

# Aset yang di-generate (regenerasi via branding/generate_*.py)
branding/preview/

# Environment & rahasia — JANGAN PERNAH commit nilai asli
.env
.env.local
.env.*.local
*.keystore
*.jks
keystore.properties
# Kecuali keystore DEBUG tetap (bukan rahasia; alias androiddebugkey) — wajib ter-commit agar
# CI bisa menandatangani APK debug secara konsisten. JANGAN pernah kecualikan keystore RILIS.
!native-overlay/android/scrola-debug.keystore

# Log & sementara
*.log
.DS_Store

# Folder penampung file yang ditandai untuk dihapus (jangan di-commit)
_to_delete/
